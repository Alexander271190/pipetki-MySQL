      id: freshId, model: 'Act Model', equipmentType: 'pipette', lastCalibration: today,
      responsible: 'Admin', serial: 'ACT-SN-' + uid
    });
    if (cr.ok) {
      createdPipettes.push(freshId);
      await reloadPipettes(); await sleep(300);

      if (typeof printSendAct === 'function') {
        _bulkSendIds = [freshId];
        const fd = document.getElementById('bulk-send-date'); if (fd) fd.value = today;
        _openCallCount = 0; _lastOpenHtml = ''; _lastBlobHtml = '';
        try { await printSendAct(); await sleep(300); } catch (e) { log('PRINT','printSendAct', 'FAIL', e.message); }
        const actHtml = _lastOpenHtml || _lastBlobHtml || '';
        log('PRINT','printSendAct: окно', (_openCallCount >= 1 || actHtml.length > 100) ? 'PASS':'FAIL', `open=${_openCallCount}, html=${actHtml.length}b`);
        log('PRINT','акт отправки: колонки', /Внутр/.test(actHtml) && /Модель/.test(actHtml) && /Серийный/.test(actHtml) ? 'PASS':'FAIL');
        _bulkSendIds = [];
      }

      await api('/pipettes/bulk-send','POST',{ ids: [freshId], sentDate: today, note: '' });
      await sleep(300); await reloadPipettes(); await sleep(200);

      if (typeof openBulkReturnModal === 'function') { try { await openBulkReturnModal(); await sleep(300); } catch (e) {} }
      if (typeof printReturnAct === 'function') {
        _bulkReturnIds = [freshId];
        const fd = document.getElementById('bulk-return-date'); if (fd) fd.value = today;
        _openCallCount = 0; _lastOpenHtml = ''; _lastBlobHtml = '';
        try { await printReturnAct(); await sleep(300); } catch (e) { log('PRINT','printReturnAct', 'FAIL', e.message); }
        const retHtml = _lastOpenHtml || _lastBlobHtml || '';
        log('PRINT','printReturnAct: окно', (_openCallCount >= 1 || retHtml.length > 100) ? 'PASS':'FAIL', `open=${_openCallCount}, html=${retHtml.length}b`);
        log('PRINT','акт возврата: колонки', /Внутр/.test(retHtml) && /Свидетельство/.test(retHtml) && /Результат/.test(retHtml) ? 'PASS':'FAIL');
        _bulkReturnIds = [];
      }
      try { if (typeof closeBulkReturnModal === 'function') closeBulkReturnModal(); } catch (e) {}

      await api('/pipettes/bulk-return','POST',{
        items: [{ id: freshId, result: 'pass', cert: 'ACT-' + uid }], date: today, org: 'Test'
      });
    }
    if (_origExportCfg) await api('/settings/export','PUT', _origExportCfg);
    const eff2 = await api('/settings/print-documents/effective');
    if (eff2.ok) settings.printDocs = eff2.body;
  }

  /* ═══ 27. UI modals ═══ */
  console.log('\n%c🪟 27. UI modals', 'font-size:14px;font-weight:bold;color:#4f46e5;');
  const modalActive = id => { const el = document.getElementById(id); return !!(el && el.classList.contains('active')); };
  {
    const checks = [
      ['openAuditModal','closeAuditModal','audit-modal'],
      ['openHistoryModal','closeHistoryModal','history-modal'],
      ['openQuickCalModal','closeQuickCalModal','quick-cal-modal'],
      ['openBarcodeScannerModal','closeBarcodeScannerModal','barcode-scanner-modal'],
      ['openHotkeysHelp','closeHotkeysHelp','hotkeys-modal'],
    ];
    for (const [openFn, closeFn, mid] of checks) {
      if (typeof window[openFn] !== 'function') { log('UI', openFn, 'SKIP'); continue; }
      try {
        const args = (openFn === 'openHistoryModal' || openFn === 'openQuickCalModal') ? [pipIds[0]] : [];
        await window[openFn](...args); await sleep(300);
        log('UI', openFn, modalActive(mid) ? 'PASS':'FAIL');
        try { if (typeof window[closeFn] === 'function') await window[closeFn](); } catch (e) {}
        await sleep(150);
      } catch (e) { log('UI', openFn, 'FAIL', e.message); }
    }

    for (const sec of ['users','roles','export','departments','fields','filters','help','equipment','printers','barcodes','view-templates']) {
      try {
        if (typeof openSettingsModal === 'function') await openSettingsModal();
        await sleep(200);
        if (typeof openSettingsSection === 'function') {
          await openSettingsSection(sec); await sleep(300);
          const c = document.getElementById('settings-section-content');
          log('UI', 'settings:' + sec, c && c.innerHTML.length > 50 ? 'PASS':'FAIL');
        }
        if (typeof closeSettingsModal === 'function') closeSettingsModal();
        await sleep(150);
      } catch (e) { log('UI', 'settings:' + sec, 'FAIL', e.message); }
    }
  }

  /* ═══ 28. UI theme ═══ */
  console.log('\n%c🌓 28. UI theme', 'font-size:14px;font-weight:bold;color:#4f46e5;');
  {
    const getTheme = () => document.documentElement.getAttribute('data-theme') || 'light';
    const before = getTheme();
    if (typeof window.toggleTheme === 'function') {
      window.toggleTheme(); await sleep(200);
      const after = getTheme();
      log('THEME','переключение', before !== after ? 'PASS':'FAIL', `${before} → ${after}`);
      window.toggleTheme(); await sleep(150);
    } else log('THEME','переключение','SKIP');
  }

  /* ═══ 29. UI keyboard ═══ */
  console.log('\n%c⌨️ 29. UI keyboard', 'font-size:14px;font-weight:bold;color:#4f46e5;');
  if (pipIds.length && typeof selectedPipettes !== 'undefined') {
    selectedPipettes.clear(); selectedPipettes.add(pipIds[0]);
    document.dispatchEvent(new KeyboardEvent('keydown', { key: 'h', ctrlKey: true, bubbles: true }));
    await sleep(400);
    log('KEYS','Ctrl+H → history', modalActive('history-modal') ? 'PASS':'FAIL');
    if (modalActive('history-modal') && typeof closeHistoryModal === 'function') closeHistoryModal();
    await sleep(200);

    document.dispatchEvent(new KeyboardEvent('keydown', { key: 'A', shiftKey: true, ctrlKey: true, bubbles: true }));
    await sleep(400);
    log('KEYS','Ctrl+Shift+A → equipment audit', modalActive('equipment-audit-modal') ? 'PASS':'FAIL');
    if (modalActive('equipment-audit-modal') && typeof closeEquipmentAuditModal === 'function') closeEquipmentAuditModal();
    selectedPipettes.clear();
  }

  /* ═══ 30. Format ═══ */
  console.log('\n%c📅 30. Format', 'font-size:14px;font-weight:bold;color:#4f46e5;');
  {
    const dt = fmtDT('2026-10-25T12:17:00');
    log('FMT','ISO date format', /^\d{2}\.\d{2}\.\d{4}\s+\d{2}:\d{2}$/.test(dt) ? 'PASS':'FAIL', dt);
    log('FMT','empty → «—»', fmtDT(null) === '—' ? 'PASS':'FAIL');
    if (typeof window.slugify === 'function') {
      log('FMT','slugify("Инвентарный номер")', window.slugify('Инвентарный номер') === 'inventarnyy_nomer' ? 'PASS':'FAIL');
      log('FMT','slugify("Весы")', window.slugify('Весы') === 'vesy' ? 'PASS':'FAIL');
    }
    const testEl = document.createElement('div'); testEl.className = 'skeleton-line';
    document.body.appendChild(testEl);
    const cs = getComputedStyle(testEl);
    log('FMT','.skeleton-line animation', cs.animationName && cs.animationName !== 'none' ? 'PASS':'FAIL');
    testEl.remove();
  }

  /* ═══ 31. app_logs ═══ */
  console.log('\n%c📋 31. app_logs', 'font-size:14px;font-weight:bold;color:#4f46e5;');
  await sleep(1500);
  {
    const r = await api('/log/errors?limit=50');
    if (r.ok && Array.isArray(r.body?.items)) {
      log('LOG','GET /log/errors', 'PASS', `${r.body.items.length} записей`);
      const has409 = r.body.items.find(x => x.status_code === 409);
      if (has409) log('LOG','409 записан', 'PASS', (has409.message || '').slice(0, 60));
    }
    log('LOG','GET /log (audit)', (await api('/log?limit=10')).ok ? 'PASS':'FAIL');
  }

  } finally {

  /* ═══ CLEANUP ═══ */
  console.log('\n%c🧹 CLEANUP', 'font-size:14px;font-weight:bold;color:#4f46e5;');

  if (_origExportCfg) { try { await api('/settings/export','PUT', _origExportCfg); } catch (e) {} }
  if (_origFiltersCfg) { try { await api('/settings/filters','PUT', _origFiltersCfg); } catch (e) {} }
  try { const e = await api('/settings/print-documents/effective'); if (e.ok) settings.printDocs = e.body; } catch (e) {}
  restoreAll();

  for (const u of createdUsers) {
    try {
      await api(`/pipettes/${encodeURIComponent(u.id)}/lock?force=true`, 'DELETE').catch(() => {});
      const r = await api('/users/' + u.id, 'DELETE');
      log('CLEAN', `DELETE user ${u.login}`, r.ok || r.status === 404 ? 'PASS':'FAIL', r.body?.error || '');
    } catch (e) { log('CLEAN', `DELETE user ${u.login}`,'FAIL', e.message); }
  }
  for (const id of createdPresets) { try { await api('/users/presets/' + id, 'DELETE'); } catch (e) {} }
  for (const id of createdPipettes) {
    try {
      await api(`/pipettes/${encodeURIComponent(id)}/lock?force=true`, 'DELETE').catch(() => {});
      const r = await api(`/pipettes/${encodeURIComponent(id)}`, 'DELETE');
      log('CLEAN', `DELETE pipette ${id}`, r.ok || r.status === 404 ? 'PASS':'FAIL', r.body?.error || '');
    } catch (e) { log('CLEAN', `DELETE pipette ${id}`,'FAIL', e.message); }
  }
  for (const id of createdRoles) {
    try { const r = await api('/roles/' + id, 'DELETE'); log('CLEAN', `DELETE role ${id}`, r.ok || r.status === 404 ? 'PASS':'FAIL'); } catch (e) {}
  }

  try { await loadPipetteData(); } catch (e) {}

  /* ═══ ИТОГ ═══ */
  const pass = results.filter(r => r.s === 'PASS').length;
  const fail = results.filter(r => r.s === 'FAIL').length;
  const skip = results.filter(r => r.s === 'SKIP').length;
  const warn = results.filter(r => r.s === 'WARN').length;

  console.log('\n' + '═'.repeat(60));
  console.log(`%c📊 ИТОГ: ✅ ${pass}  ❌ ${fail}  ⚠️ ${warn}  ⏭️ ${skip}`,
    `font-size:18px;font-weight:bold;color:${fail ? '#dc2626' : (warn ? '#eab308' : '#16a34a')};`);
  console.log('═'.repeat(60));
  if (fail > 0) { console.log('%c❌ ПРОВАЛЫ:', 'color:#dc2626;font-weight:bold;'); console.table(results.filter(r => r.s === 'FAIL')); }
  if (warn > 0) { console.log('%c⚠️ ПРЕДУПРЕЖДЕНИЯ:', 'color:#eab308;font-weight:bold;'); console.table(results.filter(r => r.s === 'WARN')); }
  if (fail === 0 && warn === 0) { console.log('%c🎉 Все проверки пройдены!', 'color:#16a34a;font-weight:bold;font-size:16px;'); }
  window.__megaTestResults = results;
  console.log('%cРезультаты: window.__megaTestResults', 'color:#64748b;');

  } // finally
})();
