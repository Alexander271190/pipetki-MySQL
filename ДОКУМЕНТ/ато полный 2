  }

  /* ═══ 32. FULL LIFECYCLE ═══ */
  console.log('\n%c🔁 32. FULL LIFECYCLE — прогон по всему циклу', 'font-size:14px;font-weight:bold;color:#8b5cf6;');
  let currentId = null;

  try {
    const seqNum = String(Date.now()).slice(-5);
    currentId = 'P-' + seqNum;

    // 0. Проверить что ID свободен
    const preCheck = await api(`/pipettes/${encodeURIComponent(currentId)}`);
    if (preCheck.ok) {
      const next = await api('/pipettes/next-id?type=pipette');
      currentId = next.body?.nextId || ('P-' + seqNum + '0');
    }

    // 1. Создать
    const createRes = await api('/pipettes', 'POST', {
      id: currentId, model: 'Lifecycle v1', equipmentType: 'pipette', lastCalibration: today,
      responsible: currentUser.fullName || 'Admin', serial: 'LC-' + seqNum, volume: '500',
      department: '', notes: 'Lifecycle test'
    });
    if (!createRes.ok) {
      log('LIFECYCLE', '1. create', 'FAIL', createRes.body?.error);
      throw new Error('cannot create');
    }
    lifecycleIds.push(currentId);
    log('LIFECYCLE', '1. create', 'PASS', currentId);

    // 2. Read
    const readRes = await api(`/pipettes/${encodeURIComponent(currentId)}`);
    log('LIFECYCLE', '2. read', readRes.ok && readRes.body?.model === 'Lifecycle v1' ? 'PASS':'FAIL', readRes.body?.computed_status || '');

    // 3. Update
    log('LIFECYCLE', '3. update', (await api(`/pipettes/${encodeURIComponent(currentId)}`, 'PUT', {
      model: 'Lifecycle v2', notes: 'Updated', volume: '1000'
    })).ok ? 'PASS':'FAIL');

    // 4. Audit
    const auditRes = await api(`/pipettes/${encodeURIComponent(currentId)}/audit`);
    log('LIFECYCLE', '4. audit trail', auditRes.ok && (auditRes.body?.items?.length || 0) >= 2 ? 'PASS':'FAIL', `${auditRes.body?.items?.length || 0} records`);

    // 5. Quick calibration
    log('LIFECYCLE', '5. quick calibration', (await api(`/pipettes/${encodeURIComponent(currentId)}/calibration`, 'POST', {
      date: today, cert: 'LC-CERT-' + seqNum, result: 'pass', org: 'LC Lab', note: 'Annual'
    })).ok ? 'PASS':'FAIL');

    // 6. History
    const histRes = await api(`/pipettes/${encodeURIComponent(currentId)}/calibration`);
    log('LIFECYCLE', '6. history', histRes.ok && (histRes.body?.length || 0) >= 1 ? 'PASS':'FAIL', `${(histRes.body || []).length} records`);

    // 7. Manual barcode
    log('LIFECYCLE', '7. set barcode', (await api('/barcodes/manual', 'POST', { id: currentId, barcode: 'LC-BC-' + seqNum })).ok ? 'PASS':'FAIL');

    // 8. PNG
    log('LIFECYCLE', '8. barcode PNG', (await apiRaw(`/barcodes/${encodeURIComponent(currentId)}/png?type=code128`)).ok ? 'PASS':'FAIL');

    // 9. Labels PDF
    log('LIFECYCLE', '9. labels PDF', (await apiRaw(`/barcodes/labels.pdf?ids=${encodeURIComponent(currentId)}&copies=1&layout=a4`)).ok ? 'PASS':'FAIL');

    // 10. Send
    const sendRes = await api('/pipettes/bulk-send', 'POST', { ids: [currentId], sentDate: today, note: 'Lifecycle send' });
    log('LIFECYCLE', '10. send to cal', sendRes.ok && sendRes.body?.successful >= 1 ? 'PASS':'FAIL', `successful=${sendRes.body?.successful}`);

    // 11. Verify sent
    const afterSend = await api(`/pipettes/${encodeURIComponent(currentId)}`);
    log('LIFECYCLE', '11. verify sent', afterSend.body?.sent_for_calibration !== null && afterSend.body?.active === false ? 'PASS':'FAIL');

    // 12. Delete while sent → 400
    log('LIFECYCLE', '12. delete while sent → 400', (await api(`/pipettes/${encodeURIComponent(currentId)}`, 'DELETE')).status === 400 ? 'PASS':'FAIL');

    // 13. Cancel send
    log('LIFECYCLE', '13. cancel send', (await api(`/pipettes/${encodeURIComponent(currentId)}/cancel-send`, 'POST')).ok ? 'PASS':'FAIL');

    // 14. Send again + return
    await api('/pipettes/bulk-send', 'POST', { ids: [currentId], sentDate: today });
    const returnRes = await api('/pipettes/bulk-return', 'POST', {
      items: [{ id: currentId, result: 'pass', cert: 'LC-RET-' + seqNum }], date: today, org: 'LC Lab', note: 'Returned'
    });
    log('LIFECYCLE', '14. return from cal', returnRes.ok && returnRes.body?.successful >= 1 ? 'PASS':'FAIL');

    // 15. Verify returned
    const afterReturn = await api(`/pipettes/${encodeURIComponent(currentId)}`);
    log('LIFECYCLE', '15. verify returned', afterReturn.body?.sent_for_calibration === null && afterReturn.body?.active === true ? 'PASS':'FAIL');

    // 16. Transfer
    const deps = (await api('/settings/departments')).body || [];
    if (deps.length > 0) {
      log('LIFECYCLE', '16. transfer', (await api(`/pipettes/${encodeURIComponent(currentId)}/transfer`, 'POST', {
        department: deps[0], responsible: 'Lifecycle User'
      })).ok ? 'PASS':'FAIL');
    } else log('LIFECYCLE', '16. transfer', 'SKIP', 'нет отделов');

    // 17. Change responsible
    const respRes = await api('/pipettes/bulk-change-responsible', 'POST', { ids: [currentId], newResponsible: 'New Owner' });
    log('LIFECYCLE', '17. change responsible', respRes.ok && respRes.body?.successful >= 1 ? 'PASS':'FAIL');

    // 18. Change type → new ID
    const typeUpdRes = await api(`/pipettes/${encodeURIComponent(currentId)}`, 'PUT', { equipmentType: 'analyzer' });
    const idChanged = typeUpdRes.ok && typeUpdRes.body?.idChanged === true;
    log('LIFECYCLE', '18. change type → new ID', idChanged ? 'PASS':'FAIL',
      idChanged ? `${currentId} → ${typeUpdRes.body.newId}` : 'ID not changed');

    if (idChanged) {
      currentId = typeUpdRes.body.newId;
      lifecycleIds[lifecycleIds.length - 1] = currentId;

      // 19. History moved
      const newHist = await api(`/pipettes/${encodeURIComponent(currentId)}/calibration`);
      log('LIFECYCLE', '19. history moved', newHist.ok && (newHist.body?.length || 0) >= 2 ? 'PASS':'FAIL', `${(newHist.body || []).length} records`);
    }

    // 20. Export Excel
    const expResp = await fetch('/api/export/xlsx', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + adminToken },
      body: JSON.stringify({
        mode: 'registry',
        meta: { title: 'Lifecycle', date: today, recordCount: 1, user: 'Test', userPosition: 'Test' },
        headers: ['ID', 'Model'],
        rows: [{ 'ID': currentId, 'Model': 'Lifecycle v2' }],
        fields: ['id', 'model']
      })
    });
    log('LIFECYCLE', '20. export to Excel', expResp.ok ? 'PASS':'FAIL');

    // 21. Delete
    const delRes = await api(`/pipettes/${encodeURIComponent(currentId)}`, 'DELETE');
    log('LIFECYCLE', '21. delete', delRes.ok ? 'PASS':'FAIL', delRes.body?.error || '');
    if (delRes.ok) {
      lifecycleIds.splice(lifecycleIds.length - 1, 1);
      // 22. Verify 404
      log('LIFECYCLE', '22. verify deleted → 404', (await api(`/pipettes/${encodeURIComponent(currentId)}`)).status === 404 ? 'PASS':'FAIL');
    }
  } catch (e) {
    console.error('❌ Lifecycle FATAL:', e);
    log('LIFECYCLE', 'FATAL', 'FAIL', e.message);
  }

  /* ═══ 33. HEADER SETTINGS ═══ */
  console.log('\n%c📄 33. HEADER SETTINGS', 'font-size:14px;font-weight:bold;color:#4f46e5;');
  {
    const r = await api('/settings/export');
    log('HDR', 'GET /export → 3 поля шапки', ['headerEnabled','headerText','headerAlign'].every(k => k in (r.body || {})) ? 'PASS':'FAIL');
    const eff = await api('/settings/print-documents/effective');
    log('HDR', 'GET /effective → 3 поля шапки', ['headerEnabled','headerText','headerAlign'].every(k => k in (eff.body || {})) ? 'PASS':'FAIL');
    const orig = r.body;
    const testText = 'HDR-' + uid;
    await api('/settings/export', 'PUT', { headerEnabled: true, headerText: testText, headerAlign: 'right' });
    const after = await api('/settings/export');
    log('HDR', 'PUT header сохраняется', after.body?.headerEnabled === true && after.body?.headerText === testText && after.body?.headerAlign === 'right' ? 'PASS':'FAIL');
    await api('/settings/export', 'PUT', { headerEnabled: true, headerText: '', headerAlign: 'left' });
    log('HDR', 'пустой headerText → ""', (await api('/settings/export')).body?.headerText === '' ? 'PASS':'FAIL');
    await api('/settings/export', 'PUT', orig);
  }

  } finally {

  /* ═══ CLEANUP ═══ */
  console.log('\n%c🧹 CLEANUP', 'font-size:14px;font-weight:bold;color:#4f46e5;');

  if (_origExportCfg) { try { await api('/settings/export','PUT', _origExportCfg); } catch (e) {} }
  if (_origFiltersCfg) { try { await api('/settings/filters','PUT', _origFiltersCfg); } catch (e) {} }
  try { const e = await api('/settings/print-documents/effective'); if (e.ok) settings.printDocs = e.body; } catch (e) {}
  restoreAll();

  for (const u of createdUsers) {
    try { const r = await api('/users/' + u.id, 'DELETE'); } catch (e) {}
  }
  for (const id of createdPresets) { try { await api('/users/presets/' + id, 'DELETE'); } catch (e) {} }
  for (const id of createdPipettes) {
    try {
      await api(`/pipettes/${encodeURIComponent(id)}/lock?force=true`, 'DELETE').catch(() => {});
      await api(`/pipettes/${encodeURIComponent(id)}`, 'DELETE');
    } catch (e) {}
  }
  for (const id of createdRoles) { try { await api('/roles/' + id, 'DELETE'); } catch (e) {} }
  for (const id of lifecycleIds) {
    try {
      await api(`/pipettes/${encodeURIComponent(id)}/lock?force=true`, 'DELETE').catch(() => {});
      await api(`/pipettes/${encodeURIComponent(id)}`, 'DELETE');
    } catch (e) {}
  }
  try { await loadPipetteData(); } catch (e) {}

  /* ═══ ИТОГ ═══ */
  const pass = results.filter(r => r.s === 'PASS').length;
  const fail = results.filter(r => r.s === 'FAIL').length;
  const skip = results.filter(r => r.s === 'SKIP').length;

  console.log('\n' + '═'.repeat(60));
  console.log(`%c📊 ИТОГ: ✅ ${pass}  ❌ ${fail}  ⏭️ ${skip}`,
    `font-size:18px;font-weight:bold;color:${fail ? '#dc2626' : '#16a34a'};`);
  console.log('═'.repeat(60));
  if (fail > 0) { console.log('%c❌ ПРОВАЛЫ:', 'color:#dc2626;font-weight:bold;'); console.table(results.filter(r => r.s === 'FAIL')); }
  if (fail === 0) console.log('%c🎉 Все проверки пройдены!', 'color:#16a34a;font-weight:bold;font-size:16px;');
  window.__megaTestResults = results;

  } // finally
})();
